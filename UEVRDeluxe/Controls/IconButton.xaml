<Button
    x:Class="UEVRDeluxe.Controls.IconButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource styButton}">
	<Grid ColumnDefinitions="Auto, *">
		<FontIcon Style="{StaticResource styButtonIcon}" Glyph="{x:Bind Glyph, Mode=OneWay}" />
		<TextBlock Grid.Column="1" Style="{StaticResource styButtonIconText}" Text="{x:Bind Label, Mode=OneWay}" />
	</Grid>
</Button>