<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UEVRDeluxe.Pages.UEVRBackendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UEVRDeluxe.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ctl="using:UEVRDeluxe.Controls"
    mc:Ignorable="d" Loaded="Page_Loaded">

	<Page.Resources>
		<Style x:Key="BackendCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
			<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="16,12,16,16" />
		</Style>

		<Style x:Key="BackendTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="24" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<Style x:Key="BackendDescriptionStyle" TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.8" />
			<Setter Property="Margin" Value="0,4,12,0" />
		</Style>

		<Style x:Key="MetadataCaptionStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Opacity" Value="0.8" />
		</Style>

		<Style x:Key="MetadataValueStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>

		<Style x:Key="BackendActionsStyle" TargetType="StackPanel">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Spacing" Value="8" />
		</Style>
	</Page.Resources>

	<Grid Margin="20,8,20,16" RowDefinitions="Auto, Auto, *, Auto" ColumnDefinitions="*">
		<StackPanel Orientation="Horizontal">
			<HyperlinkButton Click="Back_Click" Padding="0">
				<FontIcon Style="{StaticResource styBackLink}" />
			</HyperlinkButton>
			<TextBlock Style="{StaticResource styPageHeader}">UEVR Backends</TextBlock>
		</StackPanel>

		<TextBlock Grid.Row="1" Margin="0,8,0,28" TextWrapping="WrapWholeWords">
			UEVR includes several backend engine variants, and some may deliver better performance or compatibility depending on the game.
			You can update or change the backend here. Keep in mind that the newest version isn’t always the best for every game.
			To choose the backend for a specific game, open the "Edit profile" page after selecting a game.
		</TextBlock>

		<StackPanel Grid.Row="2" Spacing="12">
			<Border Style="{StaticResource BackendCardStyle}">
				<Grid ColumnDefinitions="*,200,200,180" ColumnSpacing="32">
					<StackPanel Grid.Column="0">
						<TextBlock Text="Praydog" Style="{StaticResource BackendTitleStyle}" />
						<TextBlock Style="{StaticResource BackendDescriptionStyle}">
							Original UEVR version. Most widely used, but may have issues with games using the latest UNREAL engine version.
						</TextBlock>
					</StackPanel>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Installed version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.PraydogInstalled, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="Latest version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.PraydogLatest, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="3" Style="{StaticResource BackendActionsStyle}">
						<ctl:IconButton Glyph="&#xE896;" Label="Update/Change" Click="UpdateUEVRPraydog_Click" />
						<HyperlinkButton NavigateUri="https://www.patreon.com/praydog" ToolTipService.ToolTip="Donate on Patreon" Padding="0">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Support Praydog" />
								<FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
							</StackPanel>
						</HyperlinkButton>
					</StackPanel>
				</Grid>
			</Border>

			<Border Style="{StaticResource BackendCardStyle}">
				<Grid ColumnDefinitions="*,200,200,180" ColumnSpacing="32">
					<StackPanel Grid.Column="0">
						<TextBlock Text="JoeyHodge" Style="{StaticResource BackendTitleStyle}" />
						<TextBlock Style="{StaticResource BackendDescriptionStyle}">
							Enhances compatibility with certain games using very new UNREAL engine versions.
						</TextBlock>
					</StackPanel>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Installed version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.JoeyHodgeInstalled, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="Latest version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.JoeyHodgeLatest, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="3" Style="{StaticResource BackendActionsStyle}">
						<ctl:IconButton Glyph="&#xE896;" Label="Update/Change" Click="UpdateUEVRJoeyHodge_Click" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Style="{StaticResource BackendCardStyle}">
				<Grid ColumnDefinitions="*,200,200,180" ColumnSpacing="32">
					<StackPanel Grid.Column="0">
						<TextBlock Text="AFW" Style="{StaticResource BackendTitleStyle}" />
						<TextBlock Style="{StaticResource BackendDescriptionStyle}">
							Modified version of both Praydog and JoeyHodge backends to add alternative frame warping (AFW). Boost performance in games that support DirectX 12. Increases VRAM usage and may add some visual artifacts.
						</TextBlock>
					</StackPanel>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Installed version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.PureDarkInstalled, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="Latest version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.PureDarkLatest, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="3" Style="{StaticResource BackendActionsStyle}">
						<ctl:IconButton Glyph="&#xE896;" Label="Update/Change" Click="UpdateUEVRPureDark_Click" />
						<HyperlinkButton NavigateUri="https://www.patreon.com/PureDark" ToolTipService.ToolTip="Donate on Patreon" Padding="0">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Support PureDark" />
								<FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
							</StackPanel>
						</HyperlinkButton>
					</StackPanel>
				</Grid>
			</Border>

			<Border Style="{StaticResource BackendCardStyle}">
				<Grid ColumnDefinitions="*,200,200,180" ColumnSpacing="32">
					<StackPanel Grid.Column="0">
						<TextBlock Text="Dortamur" Style="{StaticResource BackendTitleStyle}" />
						<TextBlock Style="{StaticResource BackendDescriptionStyle}">
							Backend to fix the game "Satisfactory" (and possibly others).
						</TextBlock>
					</StackPanel>

					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Installed version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.DortamurInstalled, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="2" VerticalAlignment="Center">
						<TextBlock Text="Latest version" Style="{StaticResource MetadataCaptionStyle}" />
						<TextBlock Text="{x:Bind VM.DortamurLatest, Mode=OneWay}" Style="{StaticResource MetadataValueStyle}" />
					</StackPanel>

					<StackPanel Grid.Column="3" Style="{StaticResource BackendActionsStyle}">
						<ctl:IconButton Glyph="&#xE896;" Label="Update/Change" Click="UpdateUEVRDortamur_Click" />
						<HyperlinkButton NavigateUri="https://ko-fi.com/dortamur" ToolTipService.ToolTip="Donate on Ko-fi" Padding="0">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<TextBlock Text="Support Dortamur" />
								<FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
							</StackPanel>
						</HyperlinkButton>
					</StackPanel>
				</Grid>
			</Border>
		</StackPanel>

		<ctl:IconButton Grid.Row="3" Glyph="&#xE896;" Label="Update all to latest version" Click="UpdateAll_Click" />

		<ContentControl Grid.RowSpan="4" Visibility="{x:Bind VM.VisibleIfLoading,Mode=OneWay}" Style="{StaticResource styProgress}" />
	</Grid>
</Page>
